# Environment Variables Template
#
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# =============================================================================
# SERVER-SIDE ONLY VARIABLES
# =============================================================================
# These variables are NEVER exposed to the browser
# Do NOT use NEXT_PUBLIC_ prefix for sensitive data

# Database Configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/blessed_irembo
# DATABASE_POOL_SIZE=10

# Authentication & Security
# JWT_SECRET=your-super-secret-jwt-key-change-this
# API_SECRET_KEY=your-api-secret-key-change-this
# SESSION_SECRET=your-session-secret-change-this

# External API Keys (Server-side)
# GOOGLE_MAPS_SERVER_KEY=your-google-maps-server-api-key
# SENDGRID_API_KEY=your-sendgrid-api-key
# TWILIO_API_KEY=your-twilio-api-key

# =============================================================================
# CLIENT-SIDE VARIABLES
# =============================================================================
# These variables ARE exposed to the browser
# Only use NEXT_PUBLIC_ prefix for non-sensitive data

# Google Maps (Client-side)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-client-api-key

# API Endpoints
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_WS_URL=ws://localhost:3001

# App Configuration
# NEXT_PUBLIC_APP_NAME=Blessed Irembo
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# NODE_ENV=development
# PORT=3000

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. NEVER commit .env.local to version control
# 2. Use different secrets for development and production
# 3. Rotate all secrets regularly (at least every 90 days)
# 4. Use strong, random values for all secrets (min 32 characters)
# 5. If a secret is exposed, rotate it immediately
# 6. Use environment-specific values (dev/staging/production)
# 
# Generate secure random secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
